# ============================================================
# Environment Configuration
# ============================================================
# Copy this file to .env and update values for your machine.
# NEVER commit the .env file.
# ============================================================

# --- Dataset ---
# Absolute path to dataset root directory
DATA_ROOT=./data

# --- Model ---
# Path to trained model checkpoint
MODEL_CHECKPOINT_PATH=./models/best_model.pth

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Device ---
# Force device: "cuda", "cpu", or "auto" (default)
DEVICE=auto

# --- Config ---
# Path to config.yaml (relative to project root)
CONFIG_PATH=./configs/config.yaml
